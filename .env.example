MEALIE_BASE_URL=https://mealie.example.com
MEALIE_API_TOKEN=replace-with-mealie-api-token
# Required to enable the recipe importer. Keep this server-side only.
# OPENAI_API_KEY=replace-with-openai-api-key
# OPENAI_RECIPE_MODEL=gpt-5.6-luna
# OPENAI_RECIPE_REASONING_EFFORT=medium
PORT=3100
# Comma-separated trusted reverse-proxy IPs/CIDRs. Leave unset for direct access.
# For Dokku, use the proxy peer address from the app's request logs.
# TRUSTED_PROXIES=172.17.0.1
# APP_TIME_ZONE=Etc/UTC
# DATABASE_PATH=data/mealie-ipad-sync.sqlite
# SESSION_MAX_AGE_HOURS=6
